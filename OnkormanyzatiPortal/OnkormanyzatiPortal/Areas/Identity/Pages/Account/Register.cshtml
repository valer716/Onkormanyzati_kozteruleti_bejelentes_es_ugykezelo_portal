@page
@model OnkormanyzatiPortal.Areas.Identity.Pages.Account.RegisterModel

@{
    ViewData["Title"] = "Regisztráció";
}

<div class="d-flex align-items-center gap-3 mb-3">
    <img src="~/img/cimer.png" alt="" width="48" height="66" />
    <h1 class="m-0">Regisztráció</h1>
</div>

<div class="row">
    <div class="col-md-6 col-lg-5">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

            <div class="mb-3">
                <label asp-for="Adatok.Email" class="form-label">E-mail-cím</label>
                <input asp-for="Adatok.Email" class="form-control" autocomplete="username" />
                <span asp-validation-for="Adatok.Email" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Adatok.Jelszo" class="form-label">Jelszó</label>
                <input asp-for="Adatok.Jelszo" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="Adatok.Jelszo" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Adatok.JelszoUjra" class="form-label">Jelszó újra</label>
                <input asp-for="Adatok.JelszoUjra" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="Adatok.JelszoUjra" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Regisztráció</button>
        </form>

        <p class="mt-3">
            Van már fiókod?
            <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl">Belépés</a>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
