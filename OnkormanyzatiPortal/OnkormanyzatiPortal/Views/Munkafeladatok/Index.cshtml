@using OnkormanyzatiPortal.Models
@model IReadOnlyList<Reszfeladat>

@{
    ViewData["Title"] = "Munkafeladatok";

    var kepek = (IReadOnlyDictionary<int, int>)ViewBag.Kepek;
    var ma = DateTime.Today;
    var allapot = Context.Request.Query["allapot"].ToString();
}

<h1>Saját szervezet munkafeladatai</h1>

@if (TempData["Siker"] is string siker)
{
    <div class="alert alert-success" role="status">@siker</div>
}
@if (TempData["Hiba"] is string hiba)
{
    <div class="alert alert-danger" role="alert">@hiba</div>
}

<form asp-action="Index" method="get" class="row g-2 mb-3">
    <div class="col-sm">
        <label for="kereses" class="form-label">Keresés feladatra, ügyre vagy helyszínre</label>
        <input id="kereses" name="kereses" value="@Context.Request.Query["kereses"]" class="form-control" />
    </div>

    <div class="col-sm">
        <label for="allapot" class="form-label">Állapot</label>
        <select id="allapot" name="allapot" class="form-select">
            <option value="" selected="@(allapot == "")">Minden feladat</option>
            <option value="nyitott" selected="@(allapot == "nyitott")">Nyitott</option>
            <option value="kesz" selected="@(allapot == "kesz")">Kész</option>
        </select>
    </div>

    <div class="col-sm-auto align-self-end">
        <button class="btn btn-primary" type="submit">Szűrés</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Szűrők törlése</a>
    </div>
</form>

@if (Model.Count == 0)
{
    <p>Nincs a szűrésnek megfelelő feladat.</p>
}

<div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-3">
    @foreach (var feladat in Model)
    {
        var lejart = !feladat.Elkeszult && feladat.Hatarido.Date < ma;
        var szegely = feladat.Elkeszult ? "border-success" : lejart ? "border-danger" : "border-primary";

        <div class="col">
            <div class="card h-100 shadow-sm border-top-0 border-end-0 border-bottom-0 border-start border-4 @szegely">
                @if (kepek.TryGetValue(feladat.BejelentesId, out var fotoId))
                {
                    <img src="@Url.Action("Foto", new { id = fotoId })" alt="Bejelentői fotó"
                         class="card-img-top" style="height: 160px; object-fit: cover" loading="lazy" />
                }

                <div class="card-body">
                    <h2 class="h6">@feladat.Cim</h2>
                    <p class="mb-1">Ügy: #@feladat.BejelentesId – @feladat.Bejelentes.Cim</p>
                    <p class="mb-2 text-body-secondary">@feladat.Bejelentes.Helyszin</p>
                    <p class="mb-0">
                        Határidő: @feladat.Hatarido.ToString("yyyy.MM.dd.")
                        @if (feladat.Elkeszult)
                        {
                            <span class="badge text-bg-success">Kész</span>
                        }
                        else if (lejart)
                        {
                            <span class="badge text-bg-danger">Lejárt</span>
                        }
                        else
                        {
                            <span class="badge text-bg-primary">Nyitott</span>
                        }
                    </p>
                </div>

                <div class="card-footer bg-transparent">
                    <a asp-action="Reszletek" asp-route-id="@feladat.Id" class="btn btn-primary btn-sm">Megnyitás</a>
                </div>
            </div>
        </div>
    }
</div>
