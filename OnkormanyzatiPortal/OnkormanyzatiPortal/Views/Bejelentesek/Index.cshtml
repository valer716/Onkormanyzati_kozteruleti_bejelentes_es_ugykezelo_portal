@using OnkormanyzatiPortal.Models
@model IReadOnlyList<Bejelentes>

@{
    ViewData["Title"] = "Beérkezett bejelentések";

    var kepek = (IReadOnlyDictionary<int, int>)ViewBag.Kepek;
    int oldal = ViewBag.Oldal;
    int oldalSzam = ViewBag.OldalSzam;
}

<h1>Beérkezett bejelentések</h1>

<form asp-action="Index" method="get" class="row g-2 mb-3">
    <div class="col-sm">
        <label for="kereses" class="form-label">Keresés címre vagy helyszínre</label>
        @Html.TextBox("kereses", null, new { @class = "form-control" })
    </div>

    <div class="col-sm">
        <label for="kategoria" class="form-label">Kategória</label>
        @Html.DropDownList(
            "kategoria",
            Html.GetEnumSelectList<BejelentesKategoria>(),
            "Minden kategória",
            new { @class = "form-select" })
    </div>

    <div class="col-sm">
        <label for="allapot" class="form-label">Állapot</label>
        @Html.DropDownList(
            "allapot",
            Html.GetEnumSelectList<BejelentesAllapot>(),
            "Minden állapot",
            new { @class = "form-select" })
    </div>

    <div class="col-sm-auto align-self-end">
        <button class="btn btn-primary" type="submit">Szűrés</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Szűrők törlése</a>
    </div>
</form>

@if (Model.Count == 0)
{
    <p>Nincs találat.</p>
}
else
{
    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th>Azonosító</th>
                    <th>Kép</th>
                    <th>Cím</th>
                    <th>Helyszín</th>
                    <th>Kategória</th>
                    <th>Állapot</th>
                    <th>Beérkezés (UTC)</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var bejelentes in Model)
                {
                    <tr>
                        <td>@bejelentes.Id</td>
                        <td>
                            @if (kepek.TryGetValue(bejelentes.Id, out var fotoId))
                            {
                                <a asp-action="Reszletek" asp-route-id="@bejelentes.Id">
                                    <img src="@Url.Action("Foto", new { id = fotoId })" alt="Bejelentői fotó"
                                         width="72" height="54" class="rounded border"
                                         style="object-fit: cover" loading="lazy" />
                                </a>
                            }
                        </td>
                        <td>
                            <a asp-action="Reszletek" asp-route-id="@bejelentes.Id">
                                @bejelentes.Cim
                            </a>
                            @if (bejelentes.Veszelyes)
                            {
                                <strong class="text-danger ms-2">Veszélyes</strong>
                            }
                        </td>
                        <td>@bejelentes.Helyszin</td>
                        <td>@Html.DisplayFor(_ => bejelentes.Kategoria)</td>
                        <td>@Html.DisplayFor(_ => bejelentes.Allapot)</td>
                        <td>@bejelentes.LetrehozvaUtc.ToString("yyyy.MM.dd. HH:mm")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <p>Összesen @ViewBag.Darab bejelentés, @oldal. oldal a(z) @oldalSzam közül.</p>

    @if (oldalSzam > 1)
    {
        <nav aria-label="Lapozás">
            <ul class="pagination">
                <li class="page-item @(oldal <= 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index"
                       asp-route-kereses="@Context.Request.Query["kereses"]"
                       asp-route-kategoria="@Context.Request.Query["kategoria"]"
                       asp-route-allapot="@Context.Request.Query["allapot"]"
                       asp-route-oldal="@(oldal - 1)">Előző</a>
                </li>
                <li class="page-item @(oldal >= oldalSzam ? "disabled" : "")">
                    <a class="page-link" asp-action="Index"
                       asp-route-kereses="@Context.Request.Query["kereses"]"
                       asp-route-kategoria="@Context.Request.Query["kategoria"]"
                       asp-route-allapot="@Context.Request.Query["allapot"]"
                       asp-route-oldal="@(oldal + 1)">Következő</a>
                </li>
            </ul>
        </nav>
    }
}