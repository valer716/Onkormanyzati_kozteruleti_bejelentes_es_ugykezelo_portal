@using Microsoft.AspNetCore.WebUtilities
@using OnkormanyzatiPortal.Models
@model IReadOnlyList<Bejelentes>

@{
    ViewData["Title"] = "Beérkezett bejelentések";

    var kepek = (IReadOnlyDictionary<int, int>)ViewBag.Kepek;
    int oldal = ViewBag.Oldal;
    int oldalSzam = ViewBag.OldalSzam;

    var kijeloltAllapotok = Context.Request.Query["allapot"].ToHashSet();
    var kijeloltKategoriak = Context.Request.Query["kategoria"].ToHashSet();
    string rendez = Context.Request.Query["rendez"];
    string irany = Context.Request.Query["irany"];

    var kategoriaNevek = Html.GetEnumSelectList<BejelentesKategoria>().OrderBy(x => x.Text).ToList();
    var allapotNevek = Html.GetEnumSelectList<BejelentesAllapot>().ToList();

    string Hivatkozas(string? ujRendez, string? ujIrany, int ujOldal)
    {
        var parameterek = new List<KeyValuePair<string, string?>>();

        foreach (var elem in Context.Request.Query)
        {
            if (elem.Key is "oldal" or "rendez" or "irany")
                continue;

            foreach (var ertek in elem.Value)
                parameterek.Add(new KeyValuePair<string, string?>(elem.Key, ertek));
        }

        if (ujRendez is not null)
        {
            parameterek.Add(new KeyValuePair<string, string?>("rendez", ujRendez));
            parameterek.Add(new KeyValuePair<string, string?>("irany", ujIrany));
        }

        if (ujOldal > 1)
            parameterek.Add(new KeyValuePair<string, string?>("oldal", ujOldal.ToString()));

        return QueryHelpers.AddQueryString(Url.Action("Index")!, parameterek);
    }

    string Fejlec(string kulcs, string cimke)
    {
        var aktiv = rendez == kulcs;
        var uj = aktiv && irany != "csokkeno" ? "csokkeno" : "novekvo";
        var jel = aktiv ? (irany == "csokkeno" ? " ▼" : " ▲") : "";
        return $"<a href=\"{Hivatkozas(kulcs, uj, 1)}\" class=\"text-reset text-decoration-none\">{cimke}{jel}</a>";
    }
}

<h1>Beérkezett bejelentések</h1>

<form id="szuroUrlap" asp-action="Index" method="get" class="mb-3">
    <div class="row g-3">
        <div class="col-lg-4">
            <label for="kereses" class="form-label">Keresés címre vagy helyszínre</label>
            @Html.TextBox("kereses", null, new { @class = "form-control", autocomplete = "off" })
        </div>

        <div class="col-lg-4">
            <div class="form-label">Állapot</div>
            @foreach (var allapot in allapotNevek)
            {
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="allapot" value="@allapot.Value"
                           id="allapot-@allapot.Value" checked="@kijeloltAllapotok.Contains(allapot.Value)" />
                    <label class="form-check-label" for="allapot-@allapot.Value">@allapot.Text</label>
                </div>
            }
        </div>

        <div class="col-lg-4">
            <div class="form-label">Kategória</div>
            @foreach (var kategoria in kategoriaNevek)
            {
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="kategoria" value="@kategoria.Value"
                           id="kategoria-@kategoria.Value" checked="@kijeloltKategoriak.Contains(kategoria.Value)" />
                    <label class="form-check-label" for="kategoria-@kategoria.Value">@kategoria.Text</label>
                </div>
            }
        </div>
    </div>

    <input type="hidden" name="rendez" value="@rendez" />
    <input type="hidden" name="irany" value="@irany" />

    <div class="mt-3">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Szűrők törlése</a>
    </div>
</form>

<div id="listaTarolo">
    @if (Model.Count == 0)
    {
        <p>Nincs találat.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>@Html.Raw(Fejlec("azonosito", "Azonosító"))</th>
                        <th>Kép</th>
                        <th>@Html.Raw(Fejlec("cim", "Cím"))</th>
                        <th>@Html.Raw(Fejlec("helyszin", "Helyszín"))</th>
                        <th>@Html.Raw(Fejlec("kategoria", "Kategória"))</th>
                        <th>@Html.Raw(Fejlec("allapot", "Állapot"))</th>
                        <th>@Html.Raw(Fejlec("beerkezes", "Beérkezés (UTC)"))</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var bejelentes in Model)
                    {
                        <tr>
                            <td>@bejelentes.Id</td>
                            <td>
                                @if (kepek.TryGetValue(bejelentes.Id, out var fotoId))
                                {
                                    <a asp-action="Reszletek" asp-route-id="@bejelentes.Id">
                                        <img src="@Url.Action("Foto", new { id = fotoId })" alt="Bejelentői fotó"
                                             width="72" height="54" class="rounded border"
                                             style="object-fit: cover" loading="lazy" />
                                    </a>
                                }
                            </td>
                            <td>
                                <a asp-action="Reszletek" asp-route-id="@bejelentes.Id">
                                    @bejelentes.Cim
                                </a>
                                @if (bejelentes.Veszelyes)
                                {
                                    <strong class="text-danger ms-2">Veszélyes</strong>
                                }
                            </td>
                            <td>@bejelentes.Helyszin</td>
                            <td>@Html.DisplayFor(_ => bejelentes.Kategoria)</td>
                            <td>@Html.DisplayFor(_ => bejelentes.Allapot)</td>
                            <td>@bejelentes.LetrehozvaUtc.ToString("yyyy.MM.dd. HH:mm")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <p>Összesen @ViewBag.Darab bejelentés, @oldal. oldal a(z) @oldalSzam közül.</p>

        @if (oldalSzam > 1)
        {
            <nav aria-label="Lapozás">
                <ul class="pagination">
                    <li class="page-item @(oldal <= 1 ? "disabled" : "")">
                        <a class="page-link" href="@Hivatkozas(rendez, irany, oldal - 1)">Előző</a>
                    </li>
                    <li class="page-item @(oldal >= oldalSzam ? "disabled" : "")">
                        <a class="page-link" href="@Hivatkozas(rendez, irany, oldal + 1)">Következő</a>
                    </li>
                </ul>
            </nav>
        }
    }
</div>

@section Scripts {
    <script>
        const urlap = document.getElementById("szuroUrlap");
        const tarolo = document.getElementById("listaTarolo");
        let kesleltetes = null;
        let sorszam = 0;

        async function frissites() {
            const mostani = ++sorszam;
            const parameterek = new URLSearchParams(new FormData(urlap));

            for (const kulcs of ["rendez", "irany"]) {
                if (!parameterek.get(kulcs)) {
                    parameterek.delete(kulcs);
                }
            }

            const cim = urlap.getAttribute("action") + "?" + parameterek.toString();
            const valasz = await fetch(cim);
            const dokumentum = new DOMParser().parseFromString(await valasz.text(), "text/html");

            if (mostani !== sorszam) {
                return;
            }

            tarolo.innerHTML = dokumentum.getElementById("listaTarolo").innerHTML;
            history.replaceState(null, "", cim);
        }

        urlap.addEventListener("change", frissites);

        urlap.addEventListener("input", function (esemeny) {
            if (esemeny.target.name === "kereses") {
                clearTimeout(kesleltetes);
                kesleltetes = setTimeout(frissites, 350);
            }
        });

        urlap.addEventListener("submit", function (esemeny) {
            esemeny.preventDefault();
            frissites();
        });
    </script>
}
