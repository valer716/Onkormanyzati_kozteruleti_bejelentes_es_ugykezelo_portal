@using OnkormanyzatiPortal.Models
@model Bejelentes

@{
    ViewData["Title"] = "Bejelentés részletei";

    var feladatok = (IReadOnlyList<Reszfeladat>)ViewBag.Reszfeladatok;
    var szervezetek = (IReadOnlyList<Szervezet>)ViewBag.Szervezetek;

    var kiosztasElott = Model.Allapot is
        BejelentesAllapot.Uj or BejelentesAllapot.Ellenorizve;

    var nyitott = kiosztasElott || (Model.Allapot is
        BejelentesAllapot.Folyamatban or BejelentesAllapot.LezarasraVar);
}

<p><a asp-action="Index">Vissza az ügylistához</a></p>

<h1>#@Model.Id – @Model.Cim</h1>

@if (TempData["Siker"] is string siker)
{
    <div class="alert alert-success" role="status">@siker</div>
}

@if (TempData["Hiba"] is string hiba)
{
    <div class="alert alert-danger" role="alert">@hiba</div>
}

<dl class="row">
    <dt class="col-sm-3">Kategória</dt>
    <dd class="col-sm-9">@Html.DisplayFor(m => m.Kategoria)</dd>

    <dt class="col-sm-3">Állapot</dt>
    <dd class="col-sm-9">@Html.DisplayFor(m => m.Allapot)</dd>

    <dt class="col-sm-3">Helyszín</dt>
    <dd class="col-sm-9">@Model.Helyszin</dd>

    <dt class="col-sm-3">Ügyhatáridő</dt>
    <dd class="col-sm-9">
        @(Model.Hatarido?.ToString("yyyy.MM.dd.") ?? "Nincs megadva")
    </dd>

    <dt class="col-sm-3">Beérkezés (UTC)</dt>
    <dd class="col-sm-9">@Model.LetrehozvaUtc.ToString("yyyy.MM.dd. HH:mm")</dd>
</dl>

<h2>Leírás</h2>
<p style="white-space: pre-wrap">@Model.Leiras</p>

@if (ViewBag.Fotok is IReadOnlyList<FotoListaSor> fotok && fotok.Count > 0)
{
    <h2>Fényképek</h2>
    <div class="row g-3 mb-3">
        @foreach (var foto in fotok)
        {
            var cimke = foto.Tipus switch
            {
                BejelentesFotoTipus.Elotte => "Előtte",
                BejelentesFotoTipus.Utana => "Utána",
                _ => "Bejelentői fotó"
            };

            <div class="col-6 col-md-4 col-lg-3">
                <figure class="m-0">
                    <a asp-action="Foto" asp-route-id="@foto.Id" target="_blank">
                        <img src="@Url.Action("Foto", new { id = foto.Id })" alt="@cimke"
                             class="img-fluid rounded border" loading="lazy" />
                    </a>
                    <figcaption class="small">
                        @cimke
                        @if (foto.ReszfeladatId is int feladatId)
                        {
                            <span>– részfeladat #@feladatId</span>
                        }
                    </figcaption>
                </figure>
            </div>
        }
    </div>
}

@if (kiosztasElott)
{
    <h2>Ellenőrzés és pontosítás</h2>

    <form asp-action="Ellenoriz" asp-route-id="@Model.Id" method="post" class="mb-4">
        <div asp-validation-summary="All" class="text-danger" role="alert"></div>

        <div class="mb-3">
            <label asp-for="Cim" class="form-label">Rövid cím</label>
            <input asp-for="Cim" class="form-control" required maxlength="120" />
        </div>

        <div class="mb-3">
            <label asp-for="Leiras" class="form-label">Leírás</label>
            <textarea asp-for="Leiras" class="form-control" rows="4"
                      required maxlength="2000"></textarea>
        </div>

        <div class="mb-3">
            <label asp-for="Helyszin" class="form-label">Helyszín</label>
            <input asp-for="Helyszin" class="form-control" required maxlength="200" />
        </div>

        <div class="mb-3">
            <label asp-for="Hatarido" class="form-label">Ügyhatáridő</label>
            <input asp-for="Hatarido" asp-format="{0:yyyy-MM-dd}"
                   type="date" class="form-control" required />
        </div>

        <button type="submit" class="btn btn-primary">Mentés ellenőrzöttként</button>
    </form>
}

<h2>Részfeladatok</h2>

@if (feladatok.Count == 0)
{
    <p>Még nincs kiosztott részfeladat.</p>
}
else
{
    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th>Feladat</th>
                    <th>Szervezet</th>
                    <th>Határidő</th>
                    <th>Állapot</th>
                    <th>Megjegyzés</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var feladat in feladatok)
                {
                    <tr>
                        <td>@feladat.Cim</td>
                        <td>@feladat.Szervezet.Nev</td>
                        <td>@feladat.Hatarido.ToString("yyyy.MM.dd.")</td>
                        <td>@(feladat.Elkeszult ? "Kész" : "Kiosztva")</td>
                        <td>@feladat.Megjegyzes</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (Model.Hatarido.HasValue &&
    (Model.Allapot is BejelentesAllapot.Ellenorizve or BejelentesAllapot.Folyamatban))
{
    <h3>Új részfeladat</h3>

    <form asp-action="Kioszt" asp-route-id="@Model.Id" method="post" class="mb-4">
        <div class="mb-3">
            <label for="feladatCim" class="form-label">Feladat címe</label>
            <input id="feladatCim" name="feladatCim" class="form-control"
                   required maxlength="160" />
        </div>

        <div class="mb-3">
            <label for="szervezetId" class="form-label">Felelős szervezet</label>
            <select id="szervezetId" name="szervezetId" class="form-select" required>
                <option value="">Válassz szervezetet</option>
                @foreach (var szervezet in szervezetek)
                {
                    <option value="@szervezet.Id">@szervezet.Nev</option>
                }
            </select>
        </div>

        <div class="mb-3">
            <label for="feladatHatarido" class="form-label">Feladathatáridő</label>
            <input id="feladatHatarido" name="feladatHatarido"
                   type="date" class="form-control" required />
        </div>

        <button type="submit" class="btn btn-primary">Feladat kiosztása</button>
    </form>
}

@if (Model.Allapot == BejelentesAllapot.LezarasraVar
    && feladatok.Count > 0
    && feladatok.All(f => f.Elkeszult))
{
    <h2>Ügy lezárása</h2>
    <p>Minden részfeladat elkészült. Lezárás előtt nézd át a megjegyzéseket és a fotókat.</p>

    <form asp-action="Lezar" asp-route-id="@Model.Id" method="post" class="mb-4">
        <button type="submit" class="btn btn-success">Ellenőriztem, lezárom</button>
    </form>
}
else if (Model.LezarvaUtc is DateTime lezarvaUtc)
{
    <p>Lezárás ideje (UTC): @lezarvaUtc.ToString("yyyy.MM.dd. HH:mm")</p>
}

<h2>Különleges ügyek</h2>

@if (Model.FoBejelentesId is int foId)
{
    <p>Főügy: <a asp-action="Reszletek" asp-route-id="@foId">#@foId</a></p>
}
else
{
    <p>Jelzések száma: @ViewBag.JelzesekSzama (az eredeti bejelentéssel együtt)</p>
}

@if (Model.Veszelyes)
{
    <p class="text-danger"><strong>Veszélyes ügy</strong></p>
}

@if (ViewBag.Naplo is IReadOnlyList<BejelentesNaplo> naplo && naplo.Count > 0)
{
    var felhasznalok = (IReadOnlyDictionary<string, string>)ViewBag.Felhasznalok;

    <h2>Státusztörténet</h2>

    <div class="table-responsive">
        <table class="table table-sm">
            <thead>
                <tr>
                    <th>Időpont (UTC)</th>
                    <th>Művelet</th>
                    <th>Állapot</th>
                    <th>Végezte</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var sor in naplo)
                {
                    <tr>
                        <td>@sor.IdopontUtc.ToString("yyyy.MM.dd. HH:mm")</td>
                        <td>@sor.Muvelet</td>
                        <td>
                            @if (sor.ElozoAllapot.HasValue && sor.ElozoAllapot != sor.UjAllapot)
                            {
                                @Html.DisplayFor(_ => sor.ElozoAllapot!.Value)
                                <span>→</span>
                            }
                            @Html.DisplayFor(_ => sor.UjAllapot)
                        </td>
                        <td>
                            @(sor.FelhasznaloId is not null && felhasznalok.TryGetValue(sor.FelhasznaloId, out var nev)
                                ? nev
                                : "Lakos")
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (nyitott)
{
    <form asp-action="KulonlegesKezeles" asp-route-id="@Model.Id"
          method="post" class="mb-3">
        <button type="submit" name="muvelet"
                value="@(Model.Veszelyes ? "normal" : "veszelyes")"
                class="btn btn-outline-danger">
            @(Model.Veszelyes ? "Veszélyjelzés levétele" : "Veszélyesnek jelölöm")
        </button>
    </form>
}

@if (kiosztasElott)
{
    <form asp-action="KulonlegesKezeles" asp-route-id="@Model.Id"
          method="post" class="mb-3">
        <label for="indok" class="form-label">Döntés indoka</label>
        <input id="indok" name="indok" class="form-control mb-2"
               required maxlength="80" />

        <button type="submit" name="muvelet" value="teves"
                class="btn btn-outline-secondary">
            Téves bejelentés
        </button>

        <button type="submit" name="muvelet" value="hataskor"
                class="btn btn-outline-secondary">
            Hatáskörön kívüli
        </button>
    </form>

    <form asp-action="KulonlegesKezeles" asp-route-id="@Model.Id"
          method="post" class="mb-3">
        <label for="foBejelentesId" class="form-label">
            A már ellenőrzött főügy azonosítója
        </label>
        <input id="foBejelentesId" name="foBejelentesId" type="number"
               min="1" required class="form-control mb-2" />

        <button type="submit" name="muvelet" value="osszevon"
                class="btn btn-outline-primary">
            Összevonás a főüggyel
        </button>
    </form>
}