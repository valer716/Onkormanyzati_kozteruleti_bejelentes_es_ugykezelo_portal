@using System.Text.Json
@using OnkormanyzatiPortal.Models
@model VezetoiKimutatasNezet

@{
    ViewData["Title"] = "Vezetői kimutatás";
    ViewData["Teljes"] = true;

    DateTime? tol = ViewBag.Tol;
    DateTime? ig = ViewBag.Ig;

    var kategoriaNevek = Html.GetEnumSelectList<BejelentesKategoria>().ToDictionary(x => x.Value, x => x.Text);
    var allapotNevek = Html.GetEnumSelectList<BejelentesAllapot>().ToDictionary(x => x.Value, x => x.Text);

    string KategoriaNev(BejelentesKategoria kategoria) => kategoriaNevek[((int)kategoria).ToString()];
    string AllapotNev(BejelentesAllapot allapot) => allapotNevek[((int)allapot).ToString()];

    var lejart = Model.NyitottUgyek.Count(u => u.Lejart);
    var legtobb = Model.Teruletek.Count == 0 ? 1 : Model.Teruletek.Max(t => t.Osszes);
    var ma = DateTime.Today;

    var terkepAdat = Model.NyitottUgyek
        .Where(u => u.Szelesseg.HasValue && u.Hosszusag.HasValue)
        .Select(u => new
        {
            id = u.Id,
            cim = u.Cim,
            kategoria = KategoriaNev(u.Kategoria),
            allapot = AllapotNev(u.Allapot),
            lejart = u.Lejart,
            lat = u.Szelesseg,
            lon = u.Hosszusag,
            nap = u.NyitvaNap
        })
        .ToList();

    var grafikonAdat = new
    {
        kategoriaCimkek = Model.Kategoriak.Select(k => KategoriaNev(k.Kategoria)),
        kategoriaNyitott = Model.Kategoriak.Select(k => k.Nyitott),
        kategoriaLezart = Model.Kategoriak.Select(k => k.Lezart),
        kategoriaEgyeb = Model.Kategoriak.Select(k => k.Egyeb),
        allapotCimkek = Model.Allapotok.Select(a => AllapotNev(a.Key) + " (" + a.Value + ")"),
        allapotAdat = Model.Allapotok.Select(a => a.Value),
        haviCimkek = Model.Havi.Select(h => h.Honap),
        haviAdat = Model.Havi.Select(h => h.Darab)
    };

    var nyitottAllapotok = new[]
    {
        BejelentesAllapot.Uj,
        BejelentesAllapot.Ellenorizve,
        BejelentesAllapot.Folyamatban,
        BejelentesAllapot.LezarasraVar
    };

    string IdoszakHivatkozas(int napok) =>
        Url.Action("Index", new { tol = ma.AddDays(-napok).ToString("yyyy-MM-dd"), ig = ma.ToString("yyyy-MM-dd") })!;
}

<h1>Vezetői kimutatás</h1>

<form asp-action="Index" method="get" class="card mb-3">
    <div class="card-body d-flex flex-wrap gap-3 align-items-end">
        <div>
            <label for="tol" class="form-label mb-1">Beérkezett ettől</label>
            <input id="tol" name="tol" type="date" class="form-control" value="@tol?.ToString("yyyy-MM-dd")" />
        </div>
        <div>
            <label for="ig" class="form-label mb-1">eddig</label>
            <input id="ig" name="ig" type="date" class="form-control" value="@ig?.ToString("yyyy-MM-dd")" />
        </div>
        <button type="submit" class="btn btn-primary">Szűrés</button>
        <div class="d-flex flex-wrap gap-2">
            <a class="btn btn-outline-secondary btn-sm" href="@IdoszakHivatkozas(7)">Elmúlt 7 nap</a>
            <a class="btn btn-outline-secondary btn-sm" href="@IdoszakHivatkozas(30)">Elmúlt 30 nap</a>
            <a class="btn btn-outline-secondary btn-sm" href="@IdoszakHivatkozas(365)">Elmúlt év</a>
            <a class="btn btn-outline-secondary btn-sm" asp-action="Index">Összes</a>
        </div>
    </div>
</form>

<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="card h-100"><div class="card-body">
            <div class="text-body-secondary">Beérkezett bejelentések</div>
            <div class="display-6">@Model.OsszesUgy</div>
        </div></div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card h-100"><div class="card-body">
            <div class="text-body-secondary">Nyitott ügyek</div>
            <div class="display-6">@Model.NyitottUgyek.Count</div>
        </div></div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card h-100 @(lejart > 0 ? "border-danger" : "")"><div class="card-body">
            <div class="text-body-secondary">Határidőn túli ügyek</div>
            <div class="display-6 @(lejart > 0 ? "text-danger" : "")">@lejart</div>
        </div></div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card h-100"><div class="card-body">
            <div class="text-body-secondary">Lezárt ügyek, átlagos megoldási idő</div>
            <div class="display-6">@Model.LezartUgy <span class="fs-6 text-body-secondary">@(Model.AtlagosMegoldasiNap is double nap ? $"átlag {nap:0} nap" : "")</span></div>
        </div></div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-xl-5">
        <div class="card mb-3"><div class="card-body">
            <h2 class="h6">Kategóriák: nyitott, lezárt, egyéb</h2>
            <div style="position: relative; height: 340px"><canvas id="kategoriaGrafikon"></canvas></div>
        </div></div>
        <div class="card mb-3"><div class="card-body">
            <h2 class="h6">Állapotok (darabszám)</h2>
            <div style="position: relative; height: 300px"><canvas id="allapotGrafikon"></canvas></div>
        </div></div>
        <div class="card"><div class="card-body">
            <h2 class="h6">Érkezett bejelentések az elmúlt 12 hónapban</h2>
            <div style="position: relative; height: 260px"><canvas id="haviGrafikon"></canvas></div>
        </div></div>
    </div>

    <div class="col-xl-7">
        <div class="sticky-xl-top" style="top: 1rem; z-index: 1">
            <div class="card"><div class="card-body">
                <h2 class="h5">Nyitott ügyek</h2>

                <div class="row g-2 mb-3">
                    <div class="col-sm-6">
                        <label for="szuroKategoria" class="form-label mb-1">Kategória</label>
                        <select id="szuroKategoria" class="form-select form-select-sm">
                            <option value="">Minden kategória</option>
                            @foreach (var kategoria in Model.Kategoriak.OrderBy(k => KategoriaNev(k.Kategoria)))
                            {
                                <option value="@((int)kategoria.Kategoria)">@KategoriaNev(kategoria.Kategoria)</option>
                            }
                        </select>
                    </div>
                    <div class="col-sm-6">
                        <label for="szuroAllapot" class="form-label mb-1">Állapot</label>
                        <select id="szuroAllapot" class="form-select form-select-sm">
                            <option value="">Minden nyitott állapot</option>
                            @foreach (var allapot in nyitottAllapotok)
                            {
                                <option value="@((int)allapot)">@AllapotNev(allapot)</option>
                            }
                        </select>
                    </div>
                    <div class="col-sm-6">
                        <label for="szuroKereses" class="form-label mb-1">Keresés címre vagy helyszínre</label>
                        <input id="szuroKereses" class="form-control form-control-sm" />
                    </div>
                    <div class="col-sm-6 align-self-end">
                        <div class="form-check">
                            <input id="szuroLejart" type="checkbox" class="form-check-input" />
                            <label for="szuroLejart" class="form-check-label">Csak a határidőn túli ügyek</label>
                        </div>
                        <div class="text-body-secondary small" id="szuroDarab"></div>
                    </div>
                </div>

                @if (terkepAdat.Count == 0)
                {
                    <p class="mb-0">Jelenleg nincs nyitott ügy térképi koordinátával.</p>
                }
                else
                {
                    <link rel="stylesheet" href="https://unpkg.com/leaflet@@1.9.4/dist/leaflet.css" />
                    <link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@@1.5.3/dist/MarkerCluster.css" />
                    <link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@@1.5.3/dist/MarkerCluster.Default.css" />

                    <div id="vezetoiTerkep" class="border rounded" style="height: 55vh; min-height: 360px;"
                         aria-label="Nyitott ügyek térképe"></div>
                    <p class="text-body-secondary small mt-2 mb-0">
                        A számmal jelölt körök közeli ügyeket fognak össze. Piros pont: határidőn túli ügy, kék pont: határidőn belüli.
                        A nagyításhoz előbb kattints a térképre.
                    </p>
                }
            </div></div>
        </div>
    </div>
</div>

@if (Model.NyitottUgyek.Count == 0)
{
    <p>Nincs nyitott ügy.</p>
}
else
{
    <div class="table-responsive mb-4" style="max-height: 70vh">
        <table class="table table-hover align-middle" id="ugyTabla">
            <thead class="sticky-top" style="background-color: var(--bs-body-bg)">
                <tr>
                    <th>Azonosító</th>
                    <th>Cím</th>
                    <th>Helyszín</th>
                    <th>Kategória</th>
                    <th>Állapot</th>
                    <th>Beérkezett</th>
                    <th>Napja nyitott</th>
                    <th>Határidő</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var ugy in Model.NyitottUgyek)
                {
                    <tr data-id="@ugy.Id" data-kat="@((int)ugy.Kategoria)" data-all="@((int)ugy.Allapot)"
                        data-lejart="@(ugy.Lejart ? "1" : "0")"
                        data-szoveg="@((ugy.Cim + " " + ugy.Helyszin).ToLowerInvariant())"
                        data-cim="@ugy.Cim" data-helyszin="@ugy.Helyszin"
                        data-kategoria="@KategoriaNev(ugy.Kategoria)" data-allapot="@AllapotNev(ugy.Allapot)"
                        data-beerkezett="@ugy.LetrehozvaUtc.ToString("yyyy.MM.dd.")" data-nap="@ugy.NyitvaNap"
                        data-hatarido="@(ugy.Hatarido?.ToString("yyyy.MM.dd.") ?? "Nincs megadva")"
                        data-foto="@(ugy.FotoId is int fotoId ? Url.Action("Foto", new { id = fotoId }) : "")"
                        data-url="@Url.Action("Reszletek", new { id = ugy.Id })">
                        <td>#@ugy.Id</td>
                        <td>@ugy.Cim</td>
                        <td>@ugy.Helyszin</td>
                        <td>@KategoriaNev(ugy.Kategoria)</td>
                        <td>@AllapotNev(ugy.Allapot)</td>
                        <td>@ugy.LetrehozvaUtc.ToString("yyyy.MM.dd.")</td>
                        <td>@ugy.NyitvaNap</td>
                        <td>
                            @(ugy.Hatarido?.ToString("yyyy.MM.dd.") ?? "Nincs megadva")
                            @if (ugy.Lejart)
                            {
                                <span class="badge text-bg-danger">Lejárt</span>
                            }
                        </td>
                        <td><button type="button" class="btn btn-outline-primary btn-sm" data-ugy-elonezet="@ugy.Id">Előnézet</button></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<h2>Kategóriák</h2>

<div class="table-responsive mb-4">
    <table class="table align-middle">
        <thead>
            <tr>
                <th>Kategória</th>
                <th>Összes</th>
                <th>Nyitott</th>
                <th>Lezárt (megoldott)</th>
                <th>Egyéb (téves, hatáskörön kívüli, összevont)</th>
                <th>Átlagos megoldási idő</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var kategoria in Model.Kategoriak)
            {
                <tr>
                    <td>@KategoriaNev(kategoria.Kategoria)</td>
                    <td>@kategoria.Osszes</td>
                    <td>@kategoria.Nyitott</td>
                    <td>@kategoria.Lezart</td>
                    <td>@kategoria.Egyeb</td>
                    <td>@(kategoria.AtlagosMegoldasiNap is double kNap ? $"{kNap:0} nap" : "–")</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<h2>Bejelentések irányítószám szerint</h2>

<p class="text-body-secondary">Az „Ismeretlen" sor azokat a bejelentéseket jelöli, amelyek helyszín szövegében nincs irányítószám. Ezek érvényes bejelentések, a térképen is megvannak.</p>

<div class="table-responsive mb-4">
    <table class="table align-middle">
        <thead>
            <tr>
                <th>Irányítószám</th>
                <th>Összes bejelentés</th>
                <th style="width: 40%"></th>
                <th>Nyitott</th>
                <th>Határidőn túli</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var terulet in Model.Teruletek)
            {
                <tr>
                    <td>@terulet.Iranyitoszam</td>
                    <td>@terulet.Osszes</td>
                    <td>
                        <div class="progress" role="progressbar" aria-label="Bejelentések száma @terulet.Iranyitoszam">
                            <div class="progress-bar" style="width: @(terulet.Osszes * 100 / legtobb)%"></div>
                        </div>
                    </td>
                    <td>@terulet.Nyitott</td>
                    <td>@terulet.Lejart</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<p class="small"><a asp-action="Export">Összesítő adatok exportja (JSON)</a></p>

<div class="modal fade" id="ugyModal" tabindex="-1" aria-labelledby="ugyModalCim" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title h5" id="ugyModalCim"></h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Bezárás"></button>
            </div>
            <div class="modal-body">
                <div class="row g-3">
                    <div class="col-md-5" id="ugyModalKepOszlop">
                        <img id="ugyModalKep" src="" alt="Bejelentői fotó" class="img-fluid rounded border" />
                    </div>
                    <div class="col-md" id="ugyModalAdatok">
                        <dl class="row mb-0">
                            <dt class="col-5">Kategória</dt><dd class="col-7" id="ugyModalKategoria"></dd>
                            <dt class="col-5">Állapot</dt><dd class="col-7" id="ugyModalAllapot"></dd>
                            <dt class="col-5">Helyszín</dt><dd class="col-7" id="ugyModalHelyszin"></dd>
                            <dt class="col-5">Beérkezett</dt><dd class="col-7" id="ugyModalBeerkezett"></dd>
                            <dt class="col-5">Napja nyitott</dt><dd class="col-7" id="ugyModalNap"></dd>
                            <dt class="col-5">Határidő</dt><dd class="col-7" id="ugyModalHatarido"></dd>
                        </dl>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <a id="ugyModalMegnyitas" class="btn btn-primary" href="#" target="_blank" rel="noopener">Megnyitás új lapon</a>
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Bezárás</button>
            </div>
        </div>
    </div>
</div>

<script type="application/json" id="terkepAdat">@Html.Raw(JsonSerializer.Serialize(terkepAdat))</script>
<script type="application/json" id="grafikonAdat">@Html.Raw(JsonSerializer.Serialize(grafikonAdat))</script>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@@4.4.1/dist/chart.umd.min.js"></script>
    <script src="https://unpkg.com/leaflet@@1.9.4/dist/leaflet.js"></script>
    <script src="https://unpkg.com/leaflet.markercluster@@1.5.3/dist/leaflet.markercluster.js"></script>
    <script>
        const grafikonAdat = JSON.parse(document.getElementById("grafikonAdat").textContent);

        if (window.Chart) {
            Chart.defaults.color = getComputedStyle(document.body).color;
            Chart.defaults.borderColor = "rgba(128, 128, 128, 0.35)";
            Chart.defaults.font.size = 13;

            new Chart(document.getElementById("kategoriaGrafikon"), {
                type: "bar",
                data: {
                    labels: grafikonAdat.kategoriaCimkek,
                    datasets: [
                        { label: "Nyitott", data: grafikonAdat.kategoriaNyitott, backgroundColor: "#0d6efd" },
                        { label: "Lezárt", data: grafikonAdat.kategoriaLezart, backgroundColor: "#198754" },
                        { label: "Egyéb", data: grafikonAdat.kategoriaEgyeb, backgroundColor: "#6c757d" }
                    ]
                },
                options: {
                    indexAxis: "y",
                    maintainAspectRatio: false,
                    scales: { x: { stacked: true }, y: { stacked: true } },
                    plugins: { legend: { position: "bottom" } }
                }
            });

            new Chart(document.getElementById("allapotGrafikon"), {
                type: "doughnut",
                data: {
                    labels: grafikonAdat.allapotCimkek,
                    datasets: [{
                        data: grafikonAdat.allapotAdat,
                        backgroundColor: ["#6c757d", "#0dcaf0", "#0d6efd", "#ffc107", "#198754", "#dc3545", "#fd7e14", "#6f42c1"],
                        borderColor: getComputedStyle(document.body).backgroundColor,
                        borderWidth: 2
                    }]
                },
                options: { maintainAspectRatio: false, plugins: { legend: { position: "right" } } }
            });

            new Chart(document.getElementById("haviGrafikon"), {
                type: "bar",
                data: {
                    labels: grafikonAdat.haviCimkek,
                    datasets: [{ data: grafikonAdat.haviAdat, backgroundColor: "#198754" }]
                },
                options: { maintainAspectRatio: false, plugins: { legend: { display: false } } }
            });
        }

        new MutationObserver(function () {
            location.reload();
        }).observe(document.documentElement, { attributes: true, attributeFilter: ["data-bs-theme"] });

        const terkepAdat = JSON.parse(document.getElementById("terkepAdat").textContent);
        const terkepElem = document.getElementById("vezetoiTerkep");
        const sorok = [...document.querySelectorAll("#ugyTabla tbody tr")];
        const szuroKategoria = document.getElementById("szuroKategoria");
        const szuroAllapot = document.getElementById("szuroAllapot");
        const szuroKereses = document.getElementById("szuroKereses");
        const szuroLejart = document.getElementById("szuroLejart");
        const szuroDarab = document.getElementById("szuroDarab");

        let terkep = null;
        let jelolok = null;

        function szoveg(ertek) {
            const elem = document.createElement("div");
            elem.textContent = ertek;
            return elem.innerHTML;
        }

        function jeloloFrissites(lathatoAzonositok) {
            if (!terkep) {
                return;
            }

            jelolok.clearLayers();

            for (const ugy of terkepAdat) {
                if (!lathatoAzonositok.has(String(ugy.id))) {
                    continue;
                }

                const jelolo = L.circleMarker([ugy.lat, ugy.lon], {
                    radius: 9,
                    color: ugy.lejart ? "#b02a37" : "#0d6efd",
                    fillOpacity: 0.7
                });

                jelolo.bindPopup(
                    "<strong>#" + ugy.id + " " + szoveg(ugy.cim) + "</strong><br>" +
                    szoveg(ugy.kategoria) + " – " + szoveg(ugy.allapot) + "<br>" +
                    ugy.nap + " napja nyitott" + (ugy.lejart ? ", határidőn túli" : "") + "<br>" +
                    "<button type=\"button\" class=\"btn btn-sm btn-primary mt-2\" data-ugy-elonezet=\"" + ugy.id + "\">Előnézet</button>"
                );

                jelolok.addLayer(jelolo);
            }
        }

        function szures() {
            const lathato = new Set();
            const szo = szuroKereses.value.trim().toLowerCase();

            for (const sor of sorok) {
                const megfelel =
                    (!szuroKategoria.value || sor.dataset.kat === szuroKategoria.value) &&
                    (!szuroAllapot.value || sor.dataset.all === szuroAllapot.value) &&
                    (!szuroLejart.checked || sor.dataset.lejart === "1") &&
                    (!szo || sor.dataset.szoveg.includes(szo));

                sor.hidden = !megfelel;

                if (megfelel) {
                    lathato.add(sor.dataset.id);
                }
            }

            szuroDarab.textContent = lathato.size + " ügy a szűrés szerint";
            jeloloFrissites(lathato);
        }

        if (terkepElem && window.L && L.markerClusterGroup) {
            terkep = L.map(terkepElem, { scrollWheelZoom: false });

            L.tileLayer("https://tile.openstreetmap.org/{z}/{x}/{y}.png", {
                maxZoom: 19,
                attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>'
            }).addTo(terkep);

            jelolok = L.markerClusterGroup();
            terkep.addLayer(jelolok);

            terkep.fitBounds(terkepAdat.map(u => [u.lat, u.lon]), { padding: [25, 25], maxZoom: 14 });

            terkep.on("click", function () {
                terkep.scrollWheelZoom.enable();
            });

            terkepElem.addEventListener("mouseleave", function () {
                terkep.scrollWheelZoom.disable();
            });
        } else if (terkepElem) {
            terkepElem.textContent = "A térkép nem töltődött be. Az ügyek a táblázatban láthatók.";
        }

        for (const elem of [szuroKategoria, szuroAllapot, szuroKereses, szuroLejart]) {
            elem.addEventListener("input", szures);
        }

        document.addEventListener("click", function (esemeny) {
            const gomb = esemeny.target.closest("[data-ugy-elonezet]");

            if (!gomb) {
                return;
            }

            const sor = document.querySelector("#ugyTabla tbody tr[data-id=\"" + gomb.dataset.ugyElonezet + "\"]");

            if (!sor) {
                return;
            }

            document.getElementById("ugyModalCim").textContent = "#" + sor.dataset.id + " – " + sor.dataset.cim;
            document.getElementById("ugyModalKategoria").textContent = sor.dataset.kategoria;
            document.getElementById("ugyModalAllapot").textContent = sor.dataset.allapot;
            document.getElementById("ugyModalHelyszin").textContent = sor.dataset.helyszin;
            document.getElementById("ugyModalBeerkezett").textContent = sor.dataset.beerkezett;
            document.getElementById("ugyModalNap").textContent = sor.dataset.nap;
            document.getElementById("ugyModalHatarido").textContent = sor.dataset.hatarido;
            document.getElementById("ugyModalMegnyitas").href = sor.dataset.url;

            const kep = document.getElementById("ugyModalKep");
            document.getElementById("ugyModalKepOszlop").hidden = !sor.dataset.foto;
            kep.src = sor.dataset.foto || "";

            bootstrap.Modal.getOrCreateInstance(document.getElementById("ugyModal")).show();
        });

        szures();
    </script>
}
