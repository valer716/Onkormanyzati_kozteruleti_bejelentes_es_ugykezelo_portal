@{
    ViewData["Title"] = "Kezdőlap";
}

<div class="text-center py-3">
    <div class="bg-white rounded-4 shadow-sm p-3 mb-4 mx-auto" style="max-width: 600px">
        <img src="~/img/logo.png" alt="Közterület Bejelentő – Lovagok"
             class="img-fluid w-100" />
    </div>

    <h1 class="h3">Üdvözlünk a Közterület Bejelentőn!</h1>
    <p class="lead">Jelents be közterületi problémát, vagy nézd meg egy korábbi bejelentésed állapotát.</p>

    <div class="d-flex flex-wrap justify-content-center gap-2">
        <a asp-area="" asp-controller="Bejelentesek" asp-action="Letrehozas"
           class="btn btn-primary btn-lg">Új bejelentés</a>

        <a asp-area="" asp-controller="Bejelentesek" asp-action="Kovetes"
           class="btn btn-outline-secondary btn-lg">Ügykövetés</a>
    </div>
</div>
