<div class="modal fade" id="fotoModal" tabindex="-1" aria-labelledby="fotoModalCim" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title h5" id="fotoModalCim">Fénykép</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Bezárás"></button>
            </div>
            <div class="modal-body text-center">
                <img id="fotoModalKep" src="" alt="" class="img-fluid" />
            </div>
            <div class="modal-footer">
                <a id="fotoModalMegnyitas" class="btn btn-outline-secondary" href="#" target="_blank" rel="noopener">Megnyitás új lapon</a>
                <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Bezárás</button>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        document.addEventListener("click", function (esemeny) {
            const elem = esemeny.target.closest("[data-foto-url]");

            if (!elem) {
                return;
            }

            esemeny.preventDefault();

            const url = elem.getAttribute("data-foto-url");
            const cim = elem.getAttribute("data-foto-cim") || "Fénykép";

            document.getElementById("fotoModalKep").src = url;
            document.getElementById("fotoModalKep").alt = cim;
            document.getElementById("fotoModalCim").textContent = cim;
            document.getElementById("fotoModalMegnyitas").href = url;

            bootstrap.Modal.getOrCreateInstance(document.getElementById("fotoModal")).show();
        });
    });
</script>
